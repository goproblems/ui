{
    "name": "@goproblems/ui",
    "version": "0.4.1",
    "private": true,
    "description": "Shared GoProblems and Josekipedia React web components and themes.",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/goproblems/ui.git"
    },
    "homepage": "https://github.com/goproblems/ui#readme",
    "bugs": {
        "url": "https://github.com/goproblems/ui/issues"
    },
    "files": [
        "dist",
        "src"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./icons": {
            "types": "./dist/icons.d.ts",
            "import": "./dist/icons.js",
            "default": "./dist/icons.js"
        },
        "./styles.css": "./dist/styles.css",
        "./theme.css": "./dist/theme.css"
    },
    "scripts": {
        "check": "tsc --noEmit",
        "build": "node scripts/build.mjs",
        "test": "pnpm build && node --test test/*.test.mjs",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "framer-motion": "^12.42.2"
    },
    "peerDependencies": {
        "@fortawesome/fontawesome-svg-core": "^6.7.2 || ^7.0.0",
        "@fortawesome/free-solid-svg-icons": "^6.7.2 || ^7.0.0",
        "@fortawesome/react-fontawesome": "^3.3.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "devDependencies": {
        "@babel/core": "8.0.1",
        "@babel/preset-react": "8.0.1",
        "@babel/preset-typescript": "8.0.7",
        "@fortawesome/fontawesome-svg-core": "6.7.2",
        "@fortawesome/free-solid-svg-icons": "6.7.2",
        "@fortawesome/react-fontawesome": "3.3.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "babel-plugin-react-compiler": "1.0.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@11.10.0",
    "sideEffects": [
        "**/*.css"
    ],
    "types": "./dist/index.d.ts"
}
